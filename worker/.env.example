# Copy to .env and fill in.

# ID of the Google Sheet used as the queue (from the spreadsheet URL).
SHEET_ID=your-google-sheet-id-here

# Tab name inside the sheet.
SHEET_NAME=Queue

# Poll interval in milliseconds.
POLL_INTERVAL=3000

# Default model if a row doesn't specify one. Leave blank for CLI default.
DEFAULT_MODEL=

# Max seconds to let a single claude -p call run.
CLAUDE_TIMEOUT_SEC=300

# Path to the gws binary (usually on PATH, set only if needed).
GWS_BIN=gws

# --- Local model (optional) ---
# An OpenAI-compatible llama-server (e.g. PrismML Bonsai 2 27B) used as an
# alternate engine. Leave LOCAL_MODEL_ENABLED=0 to disable entirely.
# Rows route here when the model column (H) says "local" / "bonsai" / "bonsai2".
# Tool-use rows always stay on claude, since the local path has no tool loop.
LOCAL_MODEL_ENABLED=0
LOCAL_MODEL_URL=http://127.0.0.1:8091
LOCAL_MODEL_NAME=local

# Max seconds for one local call.
LOCAL_MODEL_TIMEOUT_SEC=300

# Max answer tokens. The model thinks by default, and thinking consumes this
# budget, so keep a reasoning budget set below.
LOCAL_MODEL_MAX_TOKENS=2048

# Thinking budget for local calls. 0 = no thinking (fast, best for extraction
# and short answers). Unset = model default, which is slow on a laptop.
LOCAL_MODEL_REASONING_BUDGET=0

# Fallback policy, each direction independent:
#   LOCAL_FALLBACK_FROM_CLAUDE=1  claude fails  -> retry on the local server
#   LOCAL_FALLBACK_TO_CLAUDE=1    local fails   -> retry on claude
LOCAL_FALLBACK_FROM_CLAUDE=1
LOCAL_FALLBACK_TO_CLAUDE=1
